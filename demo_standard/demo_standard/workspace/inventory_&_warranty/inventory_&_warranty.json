 "content": "[{\"id\": \"\u0645\u0631\u0643\u0632-\u0627\u0644\u0645\u062e\u0632\u0648\u0646-\u0648\u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a-header\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>\u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u0648\u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a</b></span><br><span class=\\\"small text-muted\\\">\u0627\u0633\u062a\u0644\u0627\u0645\u0627\u062a\u060c \u062a\u062d\u0648\u064a\u0644\u0627\u062a\u060c \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0631\u0635\u064a\u062f\u060c \u0648\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0648\u0631\u064a\u062f \u0645\u0646 \u0645\u0643\u0627\u0646 \u0648\u0627\u062d\u062f</span>\", \"col\": 12}}, {\"id\": \"\u0645\u0631\u0643\u0632-\u0627\u0644\u0645\u062e\u0632\u0648\u0646-\u0648\u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a-chart-1\", \"type\": \"chart\", \"data\": {\"chart_name\": \"\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u062e\u0632\u0648\u0646 \u062d\u0633\u0628 \u0627\u0644\u0645\u062e\u0632\u0646\", \"col\": 12}}, {\"id\": \"\u0645\u0631\u0643\u0632-\u0627\u0644\u0645\u062e\u0632\u0648\u0646-\u0648\u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a-metric-1\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u062e\u0632\u0648\u0646\", \"col\": 3}}, {\"id\": \"\u0645\u0631\u0643\u0632-\u0627\u0644\u0645\u062e\u0632\u0648\u0646-\u0648\u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a-metric-2\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"\u0627\u0644\u0623\u0635\u0646\u0627\u0641 \u0627\u0644\u0646\u0634\u0637\u0629\", \"col\": 3}}, {\"id\": \"\u0645\u0631\u0643\u0632-\u0627\u0644\u0645\u062e\u0632\u0648\u0646-\u0648\u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a-metric-3\", \"type\": \"number_card\", \"data\": {\"number_card_name\": \"\u0627\u0644\u0645\u0648\u0631\u062f\u0648\u0646 \u0627\u0644\u064